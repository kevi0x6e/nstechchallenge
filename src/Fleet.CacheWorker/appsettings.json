{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": { "SingleLine": true, "TimestampFormat": "HH:mm:ss.fff " }
    }
  },
  "Kafka": {
    "BootstrapServers": "localhost:9092",
    "GroupId": "fleet-cache-worker",
    "VehiclesTopic": "fleet.public.vehicles",
    "PositionsTopic": "fleet.public.positions",
    "MaxBatchSize": 2000,
    "MaxBatchWaitMs": 20
  },
  "Valkey": {
    "ConnectionString": "localhost:6379"
  }
}
